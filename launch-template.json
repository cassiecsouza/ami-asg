{
  "LaunchTemplateData": {
    "BlockDeviceMappings": [
      {
        "DeviceName": "/dev/xvda",
        "Ebs": {
          "DeleteOnTermination": true,
          "Encrypted": true,
          "VolumeSize": "<+serviceVariables.rootEbsVolumeSize>",
          "VolumeType": "gp3"
        }
      },
      {
        "DeviceName": "/dev/sdm",
        "Ebs": {
          "DeleteOnTermination": true,
          "Encrypted": true,
          "VolumeSize": "<+serviceVariables.dataEbsVolumeSize>",
          "VolumeType": "gp3"
        }
      }
    ],
    "IamInstanceProfile": {
      "Name": "<+serviceVariables.customerRole>"
    },
    "InstanceType": "<+serviceVariables.ec2InstanceType>",
    "MetadataOptions": {
      "HttpEndpoint": "enabled",
      "HttpPutResponseHopLimit": 2,
      "HttpTokens": "required",
      "InstanceMetadataTags": "enabled"
    },
    "Monitoring": {
      "Enabled": true
    },
    "NetworkInterfaces": [
      {
        "AssociatePublicIpAddress": true,
        "DeviceIndex": 0,
        "Groups": "<+serviceVariables.securityGroupIDs.split(\",\")>"
      }
    ],
    "TagSpecifications": [
      {
        "ResourceType": "instance",
        "Tags": [
          { "Key": "claimed_ownership", "Value": "true" },
          { "Key": "creator", "Value": "harness" },
          { "Key": "platform:managed-by", "Value": "autoscaling-group" },
          { "Key": "platform:role", "Value": "<+serviceVariables.customerRole>" },
          { "Key": "platform:system", "Value": "<+serviceVariables.customerSystem>" },
          { "Key": "platform:team", "Value": "<+serviceVariables.customerTeam>" },
          { "Key": "tcss:classification", "Value": "<+serviceVariables.securityClassification>" },
          { "Key": "tcss:owner", "Value": "<+serviceVariables.customerTeam>" },
          { "Key": "tcss:repo", "Value": "<+serviceVariables.creatorGitRepo>" },
          { "Key": "tcss:tag-version", "Value": "1" }
        ]
      },
      {
        "ResourceType": "volume",
        "Tags": [
          { "Key": "claimed_ownership", "Value": "true" },
          { "Key": "creator", "Value": "harness" },
          { "Key": "platform:managed-by", "Value": "autoscaling-group" },
          { "Key": "platform:role", "Value": "<+serviceVariables.customerRole>" },
          { "Key": "platform:system", "Value": "<+serviceVariables.customerSystem>" },
          { "Key": "platform:team", "Value": "<+serviceVariables.customerTeam>" },
          { "Key": "tcss:classification", "Value": "<+serviceVariables.securityClassification>" },
          { "Key": "tcss:owner", "Value": "<+serviceVariables.customerTeam>" },
          { "Key": "tcss:repo", "Value": "<+serviceVariables.creatorGitRepo>" },
          { "Key": "tcss:tag-version", "Value": "1" }
        ]
      }
    ]
  },
  "TagSpecifications": [
    {
      "ResourceType": "launch-template",
      "Tags": [
        { "Key": "claimed_ownership", "Value": "true" },
        { "Key": "creator", "Value": "harness" },
        { "Key": "platform:managed-by", "Value": "autoscaling-group" },
        { "Key": "platform:role", "Value": "<+serviceVariables.customerRole>" },
        { "Key": "platform:system", "Value": "<+serviceVariables.customerSystem>" },
        { "Key": "platform:team", "Value": "<+serviceVariables.customerTeam>" },
        { "Key": "tcss:classification", "Value": "<+serviceVariables.securityClassification>" },
        { "Key": "tcss:owner", "Value": "<+serviceVariables.customerTeam>" },
        { "Key": "tcss:repo", "Value": "<+serviceVariables.creatorGitRepo>" },
        { "Key": "tcss:tag-version", "Value": "1" }
      ]
    }
  ]
}
